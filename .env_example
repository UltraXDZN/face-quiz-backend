FIREBASE_TESTING_API_KEY = api_key
FIREBASE_TESTING_AUTH_DOMAIN = auth_domain.firebaseapp.com
FIREBASE_TESTING_PROJECT_ID = project_id
FIREBASE_TESTING_STORAGE_BUCKET = storage_bucket.firebasestorage.app
FIREBASE_TESTING_MESSAGING_SENDER_ID = messaging_sender_id
FIREBASE_TESTING_APP_ID = app_id

# Firebase Emulator config
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

ENVIRONMENT=development

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=OAUTH_CLIENT_SECRET

BACKEND_URL=http://localhost:8000

# JWT Secret (generate a random string for production)
JWT_SECRET=JWT_SECRET_KEY
